configuration {
    modi:                 "drun,run";
    show-icons:           true;
    icon-theme:           "gruvbox-dark-icons-gtk";
    drun-display-format:  "{name}";
    display-drun:         "Apps";
    display-run:          "Run";
    sort:                 true;
    sorting-method:       "fzf";
    matching:             "fuzzy";
    drun-use-desktop-cache: true;
    kb-mode-next:         "Control+Tab";
    kb-mode-previous:     "Control+ISO_Left_Tab";
    kb-remove-to-eol:     "";
    kb-accept-entry:      "Return,KP_Enter";
}

@import "theme.rasi"

/* Every element sets its own colors, so nothing falls back to rofi's built-in light theme. */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
}

window {
    location:         center;
    anchor:           center;
    width:            560px;
    transparency:     "real";
    background-color: transparent;
    /* 2 px green top edge, the same marker as Quickshell popups; mainbox draws the other sides. */
    border:           2px 0px 0px 0px;
    border-color:     @accent;
    border-radius:    0px;
}

mainbox {
    background-color: @surface;
    border:   0px 1px 1px 1px;
    border-color: @bg3;
    padding:  16px;
    spacing:  12px;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

inputbar {
    padding:          9px 12px;
    spacing:          10px;
    background-color: @bg0;
    border:           1px;
    border-color:     @accent;
    children:         [ "icon-search", "entry", "num-filtered-rows" ];
}

icon-search {
    expand:     false;
    filename:   "system-search-symbolic";
    size:       18px;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search";
    placeholder-color: @grey0;
    text-color:        @fg1;
    cursor:            text;
    vertical-align:    0.5;
}

num-filtered-rows {
    expand:     false;
    text-color: @grey0;
    font:       @font-caption;
    vertical-align: 0.5;
}

listview {
    lines:        8;
    columns:      1;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    fixed-height: false;
    spacing:      2px;
}

element {
    padding:  8px 10px;
    spacing:  12px;
    border:   0px 0px 0px 2px;
    border-color: transparent;
    cursor:   pointer;
}

element selected.normal,
element selected.active {
    background-color: @bg2;
    border-color:     @accent;
    text-color:       @fg1;
}

element normal.urgent,
element selected.urgent {
    text-color: @critical;
}

element normal.normal,
element alternate.normal {
    text-color: @fg0;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element-icon {
    size:            24px;
    vertical-align:  0.5;
    text-color:      inherit;
    cursor:          inherit;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    highlight:      bold #a9b665;
    cursor:         inherit;
}

message {
    border:       0px 0px 0px 2px;
    border-color: @warning;
}

textbox {
    padding:          8px 10px;
    background-color: @bg1;
    text-color:       @fg0;
    markup:           true;
}

mode-switcher {
    spacing: 0px;
}

button {
    padding:      6px 0px;
    text-color:   @grey0;
    font:         @font-caption;
    border:       0px 0px 2px 0px;
    border-color: @bg3;
    cursor:       pointer;
}

button selected {
    background-color: transparent;
    text-color:   @fg1;
    border-color: @accent;
}

error-message {
    padding:          12px;
    background-color: @surface;
    border:           2px 0px 0px 0px;
    border-color:     @critical;
}
