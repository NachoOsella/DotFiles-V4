/* Gruvbox Material Dark Hard. Same token names and values as quickshell/config/Theme.qml. */
* {
    bg0:      #1d2021;
    bg1:      #282828;
    bg2:      #32302f;
    bg3:      #3c3836;
    bg4:      #504945;
    fg1:      #ddc7a1;
    fg0:      #d4be98;
    grey2:    #a89984;
    grey1:    #928374;
    grey0:    #7c6f64;
    accent:   #a9b665;
    warning:  #d8a657;
    critical: #ea6962;

    surface:  #1d2021F0;

    /* Theme.body is 16 px and Theme.caption 12 px at 96 dpi; rofi sizes fonts in points. */
    font:          "JetBrainsMono Nerd Font 12";
    font-caption:  "JetBrainsMono Nerd Font 9";

    background-color: transparent;
    text-color:       @fg0;
}
