@import "config.rasi"

window {
    width:    560px;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

inputbar {
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @grey1;
    vertical-align: 0.5;
}

entry {
    placeholder: "Video link";
}

listview {
    lines:   2;
    dynamic: true;
}
