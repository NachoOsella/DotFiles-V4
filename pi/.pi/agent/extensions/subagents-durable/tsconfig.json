{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "declaration": false,
        "sourceMap": false,
        "outDir": ".build",
        "rootDir": ".",
        "skipLibCheck": true
    },
    "include": ["index.ts", "src/**/*.ts", "test/**/*.ts"],
    "exclude": [".build", "node_modules"]
}
